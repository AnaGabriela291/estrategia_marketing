{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/Estrategia-ANAINNOVA", "destination": "/estrategia", "permanent": true },
    { "source": "/Analisis-Victor-Heras-Viralidad", "destination": "/analisis", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
